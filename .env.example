
# PostgreSQL (used by Docker Compose and by the API when running locally)
POSTGRES_USER=clinic
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=clinicflow
POSTGRES_PORT=5432

# API database URL.
# For local development against the Docker database use localhost.
DATABASE_URL=postgresql://clinic:replace-with-a-strong-db-password@localhost:5432/clinicflow?schema=public

# Docker: API  running inside Docker Compose containers
# "db" is the PostgreSQL service name in docker-compose.yml
DATABASE_C_URL=postgresql://clinic:clinic_dev_password@db:5432/clinicflow?schema=public

# Isolated database used by the automated API test suite.
# It is created automatically by the Docker PostgreSQL init script and by the tests.
TEST_DATABASE_URL=postgresql://clinic:replace-with-a-strong-db-password@localhost:5432/clinicflow_test?schema=public

# API
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# JWT_SECRET must be at least 32 characters. Use a strong random value:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
# Set to true when served over HTTPS in production.
COOKIE_SECURE=false
# lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
CLINIC_TIMEZONE=Africa/Casablanca
LOG_LEVEL=info

# Seed credentials — required when SEED_DATABASE=true. Provide strong passwords.
SEED_ADMIN_EMAIL=admin@clinicflow.dev
SEED_ADMIN_PASSWORD=Admin123!
SEED_STAFF_EMAIL_1=staff@clinicflow.dev
SEED_STAFF_PASSWORD_1=Staff123!
SEED_STAFF_EMAIL_2=salma@clinicflow.dev
SEED_STAFF_PASSWORD_2=Staff123!


# Seed the demo dataset when the API container starts (Docker Compose only).
# Set to false for a persistent environment where seed data is not wanted.
SEED_DATABASE=true

# Frontend (baked into the Next.js bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CLINIC_TIMEZONE=Africa/Casablanca
NEXT_PUBLIC_APP_NAME=ClinicFlow

# Web
WEB_PORT=3000

# Docker image tag (optional)
COMPOSE_PROJECT_NAME=clinicflow
